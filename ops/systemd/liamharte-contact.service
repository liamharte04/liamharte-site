[Unit]
Description=Liam Harte website contact endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liamharte-deploy
Group=liamharte-deploy
EnvironmentFile=/etc/liamharte-site.env
ExecStart=/usr/bin/node /var/www/liamharte-site/current/server/contact-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/liamharte-site
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target

